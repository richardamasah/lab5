{
  "Comment": "Lakehouse Orchestration - With Validation, Error Handling, and Archiving",
  "StartAt": "Validate File (Inside StepFn)",
  "States": {
    "Validate File (Inside StepFn)": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:eu-north-1:992382846559:function:validateFileBeforeETL",
      "Parameters": {
        "FunctionName": "validateFileBeforeETL",
        "Payload.$": "$"
      },
      "Next": "Run Glue Jobs",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Fail State"
        }
      ]
    },
    "Run Glue Jobs": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "Clean Products",
          "States": {
            "Clean Products": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "clean-products-job"
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "Clean Orders",
          "States": {
            "Clean Orders": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "clean-orders-job"
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "Clean Order Items",
          "States": {
            "Clean Order Items": {
              "Type": "Task",
              "Resource": "arn:aws:states:::glue:startJobRun.sync",
              "Parameters": {
                "JobName": "clean-order-items-job"
              },
              "End": true
            }
          }
        }
      ],
      "Next": "Run Glue Crawler",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Fail State"
        }
      ]
    },
    "Run Glue Crawler": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:glue:startCrawler",
      "Parameters": {
        "Name": "lakehouse-dwh-crawler"
      },
      "Next": "Run Athena Query",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Fail State"
        }
      ]
    },
    "Run Athena Query": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:eu-north-1:992382846559:function:lakehouseAthenaQuery",
      "Parameters": {
        "FunctionName": "lakehouseAthenaQuery",
        "Payload": {
          "query": "SELECT COUNT(*) FROM products"
        }
      },
      "Next": "Archive Raw File",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Fail State"
        }
      ]
    },
    "Archive Raw File": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:eu-north-1:992382846559:function:archiveRawFile",
      "Parameters": {
        "FunctionName": "archiveRawFile",
        "Payload.$": "$"
      },
      "End": true,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Fail State"
        }
      ]
    },
    "Fail State": {
      "Type": "Fail",
      "Error": "StepFunctionFailed",
      "Cause": "Pipeline failed during validation or processing"
    }
  }
}
